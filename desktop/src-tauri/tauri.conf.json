{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "图转视频极速版-本地版",
  "version": "3.0.0-local.6",
  "identifier": "com.nideyilian.image-to-video-local",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "图转视频极速版 - 本地版",
        "width": 1440,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$TEMP/image-to-video-engine/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/image-to-video-engine"],
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxQzIyM0Y5OTU2M0MxMjkKUldRcHdXT1YrU1BDOFYzNFdYb0xJdXd0YUlxRllIelRGN01zNk1FUVpzSmRreE5mN1JsMHJPSFEK",
      "endpoints": [
        "https://github.com/nideyilian/image-to-video-local/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
